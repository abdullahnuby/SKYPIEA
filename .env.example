# Server-side only. Never prefix these with NEXT_PUBLIC_ and never put them in data-* attributes.
BENO_MARGIN_PCT=15
BENO_MARGIN_MODE=comprehensive
BENO_MIN_COVERAGE=0.70
ALLOWED_ORIGINS=https://www.example.com,https://example.com

# Neon Postgres (provisioned by `neon deploy` from neon.ts, written to .env.local).
# DATABASE_URL is the pooled connection string used by the serverless API.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct (unpooled) connection string: use it for migrations, dumps and psql.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

OWNER_WEBHOOK_URL=

# Local development only; stores leads in process memory and admin price-book edits in a local file.
# Leave it unset when DATABASE_URL is present so the API uses Neon. NEVER set BENO_LOCAL_DEMO=1 in production.
# BENO_LOCAL_DEMO=1

# Set to 0 only to disable the Postgres rate-limit gate (not recommended in production).
BENO_DURABLE_RATE_LIMIT=1

# Opt-in only; review privacy requirements before enabling.
BENO_LOG_UNMATCHED=0

# Admin login: generate local credentials with `npm run admin:setup`.
# On Vercel, set independent secrets manually; never commit a populated .env file.
BENO_ADMIN_PASSWORD=
BENO_ADMIN_SESSION_SECRET=
