# Server-side only. Never prefix these with NEXT_PUBLIC_ and never put them in data-* attributes.
BENO_MARGIN_PCT=15
BENO_MARGIN_MODE=comprehensive
BENO_MIN_COVERAGE=0.70
ALLOWED_ORIGINS=https://www.example.com,https://example.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-secret
OWNER_WEBHOOK_URL=
# Local development only; stores leads in process memory and admin price-book edits in a local file.
# NEVER set BENO_LOCAL_DEMO=1 on Vercel production.
BENO_LOCAL_DEMO=1

# Set to 0 only to disable the Supabase RPC gate (not recommended in production).
BENO_DURABLE_RATE_LIMIT=1

# Opt-in only; review privacy requirements before enabling.
BENO_LOG_UNMATCHED=0

# Admin login: generate local credentials with `npm run admin:setup`.
# On Vercel, set independent secrets manually; never commit a populated .env file.
BENO_ADMIN_PASSWORD=
BENO_ADMIN_SESSION_SECRET=
