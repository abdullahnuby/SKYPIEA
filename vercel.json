{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.js": {
      "maxDuration": 15
    },
    "api/admin/*.js": {
      "maxDuration": 15
    }
  },
  "routes": [
    {
      "src": "/admin/?$",
      "dest": "/admin.html"
    },
    {
      "src": "/api/_data/.*",
      "status": 404
    },
    {
      "handle": "filesystem"
    }
  ]
}
